# Vectora AI Environment Configuration Example
# Copy to .env and customize for your deployment environment

# Environment Mode (development | test | production)
ENVIRONMENT=production

# Database (PostgreSQL for production, SQLite for local testing)
DATABASE_URL=postgresql://vectora:vectorapass@postgres:5432/vectora_db

# Message Broker & Cache
REDIS_URL=redis://redis:6379/0

# Authentication & Security
SECRET_KEY=change-to-a-cryptographically-secure-random-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Media Storage & Models
MEDIA_STORAGE_PATH=/app/media
MODEL_REGISTRY_PATH=/app/models
ADULT_MODEL_ARTIFACT=efficientnet_b0.onnx
MODEL_MANIFEST_PATH=/app/model-registry/manifest.json

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Upload Limits
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100

# Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Web Application Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
