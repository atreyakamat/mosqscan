# Database Connection (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=postgresql://vectora:vectorapass@postgres:5432/vectora_db
# Local development SQLite fallback:
# DATABASE_URL=sqlite:///./vectora_test.db

# Background Task Broker (Redis)
REDIS_URL=redis://redis:6379/0

# JWT Security Secrets (Must be changed in production)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Media Storage
MEDIA_STORAGE_PATH=/app/media

# Model Registry and Deployment Artifacts
MODEL_REGISTRY_PATH=/app/models
ADULT_MODEL_ARTIFACT=vectora_candidate_exp_b.onnx
MODEL_MANIFEST_PATH=/app/model-registry/manifest.json
CONFIDENCE_THRESHOLD=0.50
VECTORA_CONFIDENCE_THRESHOLD=0.50

# Application Configuration
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
